# Only used on macOS. Command-line tools live in mise/config.toml, and tools with
# their own installers (rustup, uv, mise, harlequin, ansible) in
# install.conf.yaml, so they work on Linux too.
# Tools I've used and might want again are in extra-tools.md.

# Formulae

brew "git" # Distributed revision control system
brew "git-lfs" # Git extension for versioning large files

brew "gnupg" # GNU Pretty Good Privacy (PGP) package
brew "pinentry-mac" # Pinentry for GPG on Mac

brew "fish" # User-friendly command-line shell for UNIX-like operating systems
brew "fisher" # Plugin manager for the Fish shell
brew "bash"
brew "gawk" # GNU awk utility
brew "direnv" # Load/unload environment variables based on $PWD

brew "libpq" # Postgres C API library (psql, pg_dump and friends)

# Casks
cask "font-jetbrains-mono-nerd-font" # JetBrains Mono with Nerd Font icons, for eza --icons
cask "ghostty"
cask "zed" # Multiplayer code editor
cask "jetbrains-toolbox" # JetBrains tools manager
cask "temurin" # JDK from the Eclipse Foundation
cask "docker-desktop" # App to build and share containerized applications and microservices

cask "claude"
cask "linear"
cask "slack" # Team communication and collaboration software
cask "google-chrome" # Web browser
cask "obsidian"
cask "1password" # Password manager that keeps all passwords secure behind one password
cask "1password-cli" # Command-line interface for 1Password
cask "session-manager-plugin" # AWS CLI plugin for aws ssm start-session
cask "openvpn-connect"
cask "spotify" # Music streaming service

# Shows a coding agent's diff in a Rex pane. Run `rexdiff install` after installing.
tap "rednafi/rexdiff", "https://github.com/rednafi/rexdiff"
cask "rexdiff"

// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "helix_mode": false,
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "unified",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "ultracode": false,
        "model": "default"
      },
      "type": "registry"
    }
  },
  "project_panel": {
    "git_status": true,
  },
  "git_panel": {
    "button": true,
  },
  "agent_ui_font_size": 16.0,
  "snippet_sort_order": "inline",
  "auto_signature_help": false,
  "diagnostics": {
    "inline": {
      "enabled": false,
    },
  },
  "buffer_line_height": "comfortable",
  "buffer_font_family": "Monaspace Argon",
  "base_keymap": "Zed",
  "edit_predictions": {
    "disabled_globs": [],
  },
  "show_signature_help_after_edits": true,
  "completions": {
    "lsp_fetch_timeout_ms": 300,
  },
  "preferred_line_length": 90,
  "soft_wrap": "none",
  "vim_mode": true,
  "ui_font_size": 16.0,
  "buffer_font_size": 16.0,
  "terminal": {
    "font_size": 16.0,
    "option_as_meta": true,
    "shell": {
      "with_arguments": {
        "program": "/opt/homebrew/bin/fish",
        "args": ["--login"],
      },
    },
    "detect_venv": {
      "on": {
        // Default directories to search for virtual environments, relative
        // to the current working directory. We recommend overriding this
        // in your project's settings, rather than globally.
        "directories": [".venv", "venv"],
        // Can also be `csh`, `fish`, and `nushell`
        "activate_script": "default",
      },
    },
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "compositeLiteralTypes": true,
          "constantValues": true,
          "functionTypeParameters": true,
          "parameterNames": true,
          "rangeVariableTypes": true,
        },
      },
    },
    "rust-analyzer": {
      "initialization_options": {
        "check": { "command": "clippy" },
        // Separate target dir so the LSP doesn't block terminal cargo on the build lock.
        "cargo": { "targetDir": true },
      },
    },
  },
  "languages": {
    "Proto": {
      "format_on_save": "off",
    },
    "Go": {
      "formatter": [
        { "code_action": "source.organizeImports" },
        { "language_server": { "name": "gopls" } },
      ],
      "inlay_hints": {
        "show_background": false,
        "enabled": false,
      },
    },
    "Python": {
      "language_servers": ["ty", "ruff", "!basedpyright", "!pyright", "!pylsp", "..."],
      "formatter": [
        { "code_action": "source.organizeImports.ruff" },
        { "code_action": "source.fixAll.ruff" },
        { "language_server": { "name": "ruff" } },
      ],
      "tasks": { "variables": { "TEST_RUNNER": "pytest" } },
    },
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 10000,
    },
  },
}
